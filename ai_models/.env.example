# ==============================================================================
# AI Models Gateway - Environment Variables Template
# Copy this file to .env or .env.local and fill in the keys you wish to use.
# Note: Any missing key will automatically fallback to the local Recraft vector engine.
# ==============================================================================

# Anthropic Claude (Claude 3.5 Sonnet for direct SVG coding & Haiku for prompt expansion)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Google Gemini & Imagen (Gemini 1.5 Pro for multimodal & Imagen 3 for photorealism)
GEMINI_API_KEY=AIzaSy-your-key-here

# OpenAI (ChatGPT GPT-4o for prompt expansion & DALL-E 3 for image generation)
OPENAI_API_KEY=sk-proj-your-key-here

# Stability AI (Stable Diffusion 3 Medium & SDXL)
STABILITY_API_KEY=sk-your-key-here

# Replicate (Flux.1 Schnell & Community open-weight models)
REPLICATE_API_TOKEN=r8_your-token-here

